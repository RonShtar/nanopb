# Decode a message containing google.protobuf.Any, using test data that is
# produced by generator/nanopb_data_generator.py from the validation rules.

Import("env")

import sys

test_env = env.Clone()

# Enable validation code generation, and exclude validate.proto from the
# #include list since it is only used for options.
test_env.Replace(NANOPBFLAGS = "-x,validate.proto")
test_env.Replace(NANOPB_VALIDATE_FLAGS = "")

# pb_validate.h requires C99 features
cflags = str(test_env.get('CFLAGS', ''))
if '-ansi' in cflags:
    cflags = cflags.replace('-ansi', '')
test_env.Replace(CFLAGS = cflags + ' -std=c99 ')

test_env.Prepend(CPPPATH = ['.'])
test_env["PYTHON"] = test_env["ESCAPE"](sys.executable)

# Build pb_validate.o without extra strict flags (avoid conversion warnings)
validate_obj = test_env.Object("pb_validate.o", "$VALIDATE/runtime/pb_validate.c")

# Generate the test data header using the data generator
data_header = test_env.Command("any_decode_data.h",
                               ["generate_data.py", "base_message.proto"],
                               "$PYTHON ${SOURCES[0]} $TARGET")

# Generate nanopb sources; the validate plugin adds _validate.c/_validate.h
pb_files = test_env.NanopbProto("base_message")
test_env.SideEffect("base_message_validate.c", pb_files)
test_env.SideEffect("base_message_validate.h", pb_files)
test_env.NanopbProto(["google/protobuf/any", "google/protobuf/any.options"])

test_prog = test_env.Program(["decode_any_message.c",
                              "base_message.pb.c",
                              "base_message_validate.c",
                              "google/protobuf/any.pb.c",
                              "$COMMON/pb_decode.o",
                              "$COMMON/pb_common.o",
                              validate_obj])

test_env.Depends(test_prog, data_header)

test_env.RunTest(test_prog)
