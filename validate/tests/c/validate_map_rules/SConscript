# Build and run validate_map_rules test suite
# map.keys / map.values rules must be enforced on every map entry.

Import("env")

test_env = env.Clone()
test_env.Replace(NANOPBFLAGS = "-x,validate.proto")
test_env.Replace(NANOPB_VALIDATE_FLAGS = "")

# Remove -ansi flag since pb_validate.h requires C99 features (inline)
cflags = str(test_env.get('CFLAGS', ''))
if '-ansi' in cflags:
    cflags = cflags.replace('-ansi', '')
test_env.Replace(CFLAGS = cflags + ' -std=c99 ')
test_env.Prepend(CPPPATH = ['.'])

test_env.Object("pb_validate.o", "$VALIDATE/runtime/pb_validate.c")

pb_files = test_env.NanopbProto(["map_rules", "map_rules.options"])
test_env.SideEffect("map_rules_validate.c", pb_files)
test_env.SideEffect("map_rules_validate.h", pb_files)

test_prog = test_env.Program(
    ["test_map_rules.c", "map_rules.pb.c", "map_rules_validate.c",
     "$COMMON/pb_encode.o", "$COMMON/pb_decode.o", "$COMMON/pb_common.o", "pb_validate.o"]
)

test_env.RunTest(test_prog)
